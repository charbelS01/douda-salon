{
  "expo": {
    "name": "Douda Salon",
    "slug": "douda-managing-app",
    "scheme": "douda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.douda.managingapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF7F3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.douda.managingapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Douda Salon",
      "shortName": "Douda",
      "themeColor": "#B5476B",
      "backgroundColor": "#FFF7F3",
      "description": "Douda Salon management app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f4cbebce-be47-4922-83d5-8a23f43ac820"
      }
    }
  }
}
